{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "garmin-battery-alert-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "workers_dev": true,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "IDEMPOTENCY",
        "class_name": "RelayIdempotency"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RelayIdempotency"]
    }
  ]
}
